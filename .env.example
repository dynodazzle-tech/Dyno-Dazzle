# DynoDazzle Environment Configuration

# Server & Application URL
PORT=3000
APP_URL="https://dynodazzle.in"

# Supabase Configuration (Cloud Database for Enquiries)
# Obtain from your Supabase project: Settings -> API
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
# Recommended: Service Role Key (bypasses RLS for secure server-side inserts)
SUPABASE_SERVICE_ROLE_KEY=""
# Optional fallback: Anon public key
SUPABASE_ANON_KEY=""

# Gmail Configuration (for instant Client Confirmation & Admin Alert Emails)
# Primary recipient & sender: dynodazzle@gmail.com
GMAIL_USER="dynodazzle@gmail.com"
# Google App Password (16-character code created at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=""

# Notification Recipient (defaults to dynodazzle@gmail.com if omitted)
NOTIFICATION_EMAIL="dynodazzle@gmail.com"

# Generic SMTP Configuration (fallback if not using Gmail)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DynoDazzle Enquiries <dynodazzle@gmail.com>"

# Analytics Ready (disabled by default)
ENABLE_ANALYTICS=false
ANALYTICS_ID=""

# Gemini API Key (Server-side capability)
GEMINI_API_KEY=""

# Optional API Backend URL (Set this in Netlify if connecting to external backend like Cloud Run)
VITE_API_URL=""
