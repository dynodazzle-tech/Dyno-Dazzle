# Set these on the server; never commit real secrets.
PORT=3088
HOST=127.0.0.1
# Set to a long random secret. The bridge checks this on admin endpoints and n8n requests.
BRIDGE_TOKEN=replace-with-a-long-random-secret
# n8n production webhook URL created for the WhatsApp AI workflow.
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/dynodazzle-wa-ai
# Must match the shared secret configured in the n8n workflow.
N8N_SHARED_SECRET=replace-with-the-same-long-random-secret
# Set true only after QR connection and test mode are verified.
AUTO_REPLY_ENABLED=false
# Set false to ignore group chats. Recommended.
REPLY_TO_GROUPS=false
# Comma-separated JIDs or phone numbers that must never receive automatic replies.
IGNORE_SENDERS=
